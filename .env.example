# Report provider: openai, gemini or rules (offline).
INSIGHTS_PROVIDER=rules

# To use OpenAI, set INSIGHTS_PROVIDER=openai and supply your server-side key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# To use Gemini, set INSIGHTS_PROVIDER=gemini and a model enabled in your account.
GEMINI_API_KEY=
GEMINI_MODEL=

# Keep keys on the backend; never put them in Flutter or browser code.
HOST=0.0.0.0
PORT=8000

# Optional Gmail SMTP sender for the host Django backend.
# Activate via globals().update(gmail_smtp_settings()) in Django settings.
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
